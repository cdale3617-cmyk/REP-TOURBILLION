{
  "expo": {
    "name": "DRC Golf Tempo",
    "slug": "drc-golf-tourbillion",
    "version": "1.0.4",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "drc-golf-tourbillion",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#11151B"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.drc.golftourbillion",
      "versionCode": 5,
      "allowBackup": false,
      "permissions": [
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withHealthPrivacy",
      "react-native-health-connect",
      ["react-native-ble-plx", {
        "neverForLocation": true,
        "isBackgroundEnabled": false
      }],
      "expo-router",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DRC Golf Tempo to record your swing and shot videos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DRC Golf Tempo to calculate live GPS distances and find nearby courses."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DRC Golf Tempo to choose swing videos and green photos.",
          "cameraPermission": "Allow DRC Golf Tempo to capture green photos.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
